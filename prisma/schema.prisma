// Internet Time Machine — data model (plan §28)
// Dev default is SQLite for zero-setup. To move to PostgreSQL (plan §4),
// change the datasource provider and DATABASE_URL, then `npx prisma db push`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Entity {
  id             String         @id @default(cuid())
  domain         String         @unique
  name           String?
  firstCaptureAt String? // CDX timestamp YYYYMMDDhhmmss
  lastCaptureAt  String? // CDX timestamp YYYYMMDDhhmmss
  createdAt      DateTime       @default(now())
  snapshots      Snapshot[]
  events         TimelineEvent[]
}

model Snapshot {
  id          String    @id @default(cuid())
  entity      Entity    @relation(fields: [entityId], references: [id])
  entityId    String
  timestamp   String // CDX timestamp YYYYMMDDhhmmss
  archiveUrl  String // replay URL on the provider
  originalUrl String
  source      String    @default("wayback")
  contentHash String // SHA-256 of retrieved HTML (plan §30)
  createdAt   DateTime  @default(now())
  analysis    Analysis?

  @@unique([entityId, timestamp])
  @@index([entityId, timestamp])
}

model Analysis {
  id               String   @id @default(cuid())
  snapshot         Snapshot @relation(fields: [snapshotId], references: [id])
  snapshotId       String   @unique
  // content metrics (plan §13)
  wordCount        Int
  paragraphCount   Int
  headingCount     Int
  linkCount        Int
  imageCount       Int
  videoCount       Int
  formCount        Int
  // structure metrics
  domNodes         Int
  domDepth         Int
  tableCount       Int
  listCount        Int
  navRegions       Int
  navLinks         Int
  // design metrics
  distinctColors   Int
  pageSizeBytes    Int
  title            String?
  // text signal hits (plan §16): commerce / social / personal / AI wording
  textCommerce     Int      @default(0)
  textSocial       Int      @default(0)
  textPersonal     Int      @default(0)
  textAi           Int      @default(0)
  // technology signals: JSON array of {name, category, confidence, evidence}
  techSignals      String
  algorithmVersion String
  createdAt        DateTime @default(now())
  dna              Dna?

  @@index([snapshotId])
}

model Dna {
  id                   String   @id @default(cuid())
  analysis             Analysis @relation(fields: [analysisId], references: [id])
  analysisId           String   @unique
  minimalism           Int
  informationDensity   Int
  visualComplexity     Int
  socialIntensity      Int
  commercialization    Int
  personalization      Int
  mobileFocus          Int
  interactivity        Int
  mediaIntensity       Int
  aiIntegration        Int
  accessibilitySignals Int
  navigationComplexity Int
  algorithmVersion     String

  @@index([analysisId])
}

model TimelineEvent {
  id         String   @id @default(cuid())
  entity     Entity   @relation(fields: [entityId], references: [id])
  entityId   String
  snapshotA  String // CDX timestamp of the earlier capture
  snapshotB  String // CDX timestamp of the later capture
  type       String // content | structure | navigation | technology
  confidence String // high | medium
  magnitude  Int // dominant change dimension, 0–100
  evidence   String // JSON: dimension scores + detected changes
  createdAt  DateTime @default(now())

  @@unique([entityId, snapshotA, snapshotB, type])
  @@index([entityId])
}

// Evolution Lab experiment (plan §28 Experiment). Everything stored here is
// hypothetical output — isHypothetical is always true until local AI exists.
model LabExperiment {
  id           String   @id @default(cuid())
  slug         String   @unique
  domain       String
  timestamp    String // CDX timestamp of the source snapshot
  mode         String // lab engine mode id
  result       String // JSON: LabResult (versioned)
  isHypothetical Boolean @default(true)
  createdAt    DateTime @default(now())

  @@index([domain])
}

model Share {
  id         String   @id @default(cuid())
  slug       String   @unique
  domain     String
  timestampA String
  timestampB String
  createdAt  DateTime @default(now())

  @@index([slug])
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity History (ITM 2.0). A candidate identity group — NEVER "a person."
// Every claim stored here is hedged evidence, never a definitive attribution
// (master prompt: "Never claim that two accounts belong to the same person
// merely because the name or username matches").
// ─────────────────────────────────────────────────────────────────────────────

model Identity {
  id              String          @id @default(cuid())
  key             String          @unique // normalized: "johnsmith" | "johnsmith.dev"
  displayName     String
  kind            String // username | name | domain — what the user searched
  firstObservedAt String? // CDX timestamp YYYYMMDDhhmmss
  lastObservedAt  String? // CDX timestamp YYYYMMDDhhmmss
  createdAt       DateTime        @default(now())
  aliases         IdentityAlias[]
  traces          IdentityTrace[]

  @@index([kind])
}

// A public alias (username, name form, or domain) seen in public evidence.
model IdentityAlias {
  id         String   @id @default(cuid())
  identity   Identity @relation(fields: [identityId], references: [id])
  identityId String
  alias      String
  type       String // username | name | domain
  firstSeen  String? // CDX timestamp of earliest supporting trace
  lastSeen   String? // CDX timestamp of latest supporting trace
  source     String // where the alias was observed
  createdAt  DateTime @default(now())

  @@unique([identityId, alias, type])
  @@index([identityId])
}

// One publicly discoverable Internet trace (master prompt field list:
// id, identityId, type, title, url, source, observedAt, confidence, evidence).
model IdentityTrace {
  id         String   @id @default(cuid())
  identity   Identity @relation(fields: [identityId], references: [id])
  identityId String
  type       String // PROFILE | WEBSITE | DOMAIN | MENTION | PROJECT | POST | IMAGE | USERNAME
  title      String
  url        String // public URL of the trace (live or replay)
  source     String // platform / archive that surfaced it
  observedAt String // CDX timestamp YYYYMMDDhhmmss when first publicly visible
  confidence String // HIGH | MEDIUM | LOW | UNVERIFIED
  evidence   String // JSON EvidenceBundle: {source, url, date, reason, signals[]}
  createdAt  DateTime @default(now())

  sourcesOut IdentityRelationship[] @relation("source")
  targetsIn  IdentityRelationship[] @relation("target")

  @@unique([identityId, url, type])
  @@index([identityId, observedAt])
}

// An evidence-backed link between two traces (e.g. a GitHub profile that
// lists a personal website). Never an asserted same-person claim.
model IdentityRelationship {
  id              String         @id @default(cuid())
  source          IdentityTrace  @relation("source", fields: [sourceTraceId], references: [id])
  sourceTraceId   String
  target          IdentityTrace  @relation("target", fields: [targetTraceId], references: [id])
  targetTraceId   String
  relationshipType String // links-to | mentions | same-username | archived-by
  confidence      String // HIGH | MEDIUM | LOW
  evidence        String // JSON EvidenceBundle
  reason          String
  createdAt       DateTime @default(now())

  @@index([sourceTraceId])
  @@index([targetTraceId])
}
