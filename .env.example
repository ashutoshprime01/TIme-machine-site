// Local dev: SQLite, zero setup.
// Production (plan §54): swap to a free PostgreSQL tier, e.g.
// DATABASE_URL="postgresql://user:pass@host:5432/internet_time_machine"
// then change `provider = "sqlite"` to `provider = "postgresql"` in
// prisma/schema.prisma and run `npx prisma db push`.
DATABASE_URL="file:./dev.db"
ARCHIVE_PROVIDER="wayback"
